root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{yml,yaml,md,sh,toml,json}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

# Test fixtures must keep their exact bytes, including CRLF line endings.
[store/markdown/testdata/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
